<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Events and blogs from the Training and Placement Cell, IIITDM Kancheepuram.">
    <link rel="icon" href="/img/icons/logo.jpg" type="image/jpeg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/templates-1.css">
    <link rel="stylesheet" href="/css/blogs.css">
    <title>Events &amp; Blogs | Placement Cell | IIITDM Kancheepuram</title>
</head>

<body>
    <%- include('templates/header-1.ejs') -%>

    <!-- Page Hero Banner -->
    <section class="blogs-hero">
        <div class="blogs-hero-overlay"></div>
        <div class="blogs-hero-content">
            <h1 class="blogs-hero-title">Events &amp; Blogs</h1>
            <p class="blogs-hero-sub">A look back at all the events, talks, and programs hosted by our Placement Cell.</p>
        </div>
    </section>

    <!-- Events Grid Section -->
    <section class="events-section">
        <div class="events-wrapper">

            <div class="events-section-header">
                <span class="events-label">All Events</span>
                <h2 class="events-title">Past Events</h2>
                <hr class="events-divider">
            </div>

            <div class="events-grid">

                <!-- PRAGNA 2026 -->
                <a href="/blogs/pragna-2026" class="event-card">
                    <div class="event-card-img-wrap">
                        <img src="/img/blog/pragna-2026/cover.jpg" alt="PRAGNA 2026 Event" class="event-card-img" loading="lazy">
                        <span class="event-card-badge"><i class="fa fa-calendar-o" style="margin-right: 4px;"></i> 22 Aug 2026</span>
                    </div>
                    <div class="event-card-body">
                        <h3 class="event-card-title">PRAGNA 2026</h3>
                        <p class="event-card-desc">Industry talks and interactive sessions by leaders from PayPal, BNY Mellon, Tekion, Infineon, Aptiv, Hyundai, and more.</p>
                        <div class="event-card-footer">
                            <span class="event-card-meta"><i class="fa fa-users"></i> 8 Speakers</span>
                            <span class="event-card-link">View Event <i class="fa fa-arrow-right"></i></span>
                        </div>
                    </div>
                </a>

                <!-- More events will go here as blank card placeholders -->

            </div>

        </div>
    </section>

    <%- include('templates/footer-1.ejs') -%>
</body>

</html>
