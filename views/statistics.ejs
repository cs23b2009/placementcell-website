      <!-- Js snippet for animation of progress-bars stats -->
      <script>
        window.onload = () => {
          const circles = document.querySelectorAll(".outer");
          const animationDuration = 1500; // Animation duration in milliseconds
          const animationSteps = 100; // Number of steps to complete the animation

          circles.forEach((outerElement, index) => {
            const innerTextElement = outerElement.querySelector(".inner-text");
            const targetPercentages = [67.7, 65.5, 97]; // Target percentages (updated 2025-26, 2022-23, 2021-22)
            const stepDuration = animationDuration / animationSteps;

            for (let i = 0; i <= animationSteps; i++) {
              setTimeout(() => {
                const percentage = (i * targetPercentages[index]) / animationSteps; // Calculate the actual percentage
                innerTextElement.textContent = `${percentage.toFixed(1)}%`;
                const gradientStops = [
                  `#00ffe0 ${percentage - 3}%`,
                  `rgba(5, 0, 255, 0.8) ${percentage}%`,
                  `white ${percentage}%`,
                  `white ${percentage}%`,
                  `white ${percentage + 27}%`,
                  `white 100%`
                ].join(", ");
                outerElement.style.background = `conic-gradient(${gradientStops})`;

                if (percentage >= targetPercentages[index]) {
                  outerElement.style.animation = "none";
                }
              }, i * stepDuration);
            }
          });
        };
      </script>

      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const toggle = document.getElementById('stats-toggle');
          const currentStats = document.getElementById('current-stats');
          const pastStats = document.getElementById('past-stats');

          toggle.addEventListener('change', function () {
            if (this.checked) {
              currentStats.style.display = 'none';
              pastStats.style.display = 'block';
              setTimeout(() => {
                pastStats.style.opacity = '1';
                // Redraw charts now that the container is visible and has real dimensions
                if (typeof drawPlacementStats === 'function') drawPlacementStats();
                if (typeof drawChart === 'function') drawChart();
                if (typeof drawMyChart === 'function') drawMyChart();
              }, 100);
              currentStats.style.opacity = '0';
            } else {
              pastStats.style.display = 'none';
              currentStats.style.display = 'block';
              setTimeout(() => {
                currentStats.style.opacity = '1';
                // Redraw current stats charts
                if (typeof drawChart === 'function') drawChart();
                if (typeof drawMyChart === 'function') drawMyChart();
              }, 100);
              pastStats.style.opacity = '0';
            }
          });
        });
      </script>

