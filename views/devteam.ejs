<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web Developers | IIITDM Kancheepuram</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f4f6fb;
      color: #1a1a2e;
    }

    /* ── Page hero banner ── */
    .contact-hero {
      background: linear-gradient(135deg, #1a237e 0%, #283593 50%, #1565c0 100%);
      padding: 70px 20px 60px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .contact-hero::before {
      content: '';
      position: absolute;
      top: -60px;
      right: -60px;
      width: 300px;
      height: 300px;
      background: rgba(0, 255, 224, 0.08);
      border-radius: 50%;
    }

    .contact-hero::after {
      content: '';
      position: absolute;
      bottom: -80px;
      left: -40px;
      width: 250px;
      height: 250px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 50%;
    }

    .contact-hero h1 {
      font-size: 2.8rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: 0.5px;
    }

    .contact-hero p {
      color: rgba(255, 255, 255, 0.75);
      font-size: 1.05rem;
      margin-top: 0.5rem;
    }

    .hero-accent {
      display: inline-block;
      width: 60px;
      height: 4px;
      background: linear-gradient(90deg, #00ffe0, #304ffe);
      border-radius: 2px;
      margin: 1rem auto 0;
    }

    /* ── Section wrapper ── */
    .team-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    /* ── Card grid ── */
    .cards-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 40px;
      justify-content: center;
      align-items: center;
    }

    .card-student {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 3px 16px rgba(26, 35, 126, 0.08);
      overflow: hidden;
      width: 240px;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .card-student:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 24px rgba(26, 35, 126, 0.13);
    }

    .card-student .card-top-bar {
      height: 4px;
      background: linear-gradient(90deg, #00ffe0, #1a237e);
    }

    .card-student .card-img-wrap {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      margin: 24px auto 16px;
      overflow: hidden;
      border: 3px solid #e8eaf6;
      background: #f0f2ff;
    }

    .card-student .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-student .card-body {
      padding: 0 16px 24px;
      text-align: center;
    }

    .card-student .card-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: #1a237e;
      line-height: 1.3;
    }

    .card-student .card-post {
      display: inline-block;
      margin-top: 8px;
      font-size: 0.75rem;
      font-weight: 600;
      color: #3949ab;
      background: #e8eaf6;
      border-radius: 20px;
      padding: 4px 14px;
    }

    .card-student .card-contact {
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .card-student .card-contact a {
      font-size: 0.75rem;
      color: #757575;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      word-break: break-all;
      transition: color 0.2s;
    }

    .card-student .card-contact a:hover {
      color: #1a237e;
    }

    .card-student .card-contact i {
      color: #7986cb;
      font-size: 0.85rem;
    }
  </style>
</head>

<body>
  <%- include('templates/header-1.ejs') -%>

    <!-- Hero Banner -->
    <div class="contact-hero">
      <h1>Our Developers</h1>
      <p>IIITDM Kancheepuram — Placement Cell Web Team</p>
      <div class="hero-accent"></div>
    </div>

    <!-- Developers Section -->
    <div class="team-section">
      <div class="cards-grid">
        <!-- Card 1: D IndraKumar -->
        <div class="card-student">
          <div class="card-top-bar"></div>
          <div class="card-img-wrap">
            <img src="/img/coordinators_2026/indra.jpg" alt="D IndraKumar"
              onerror="this.src='/img/coordinators_2026/image.jpg'">
          </div>
          <div class="card-body">
            <h3 class="card-name">D IndraKumar</h3>
            <div class="card-contact">
              <a href="mailto:cs23b2009@iiitdm.ac.in">
                <i class="fa fa-envelope" aria-hidden="true"></i> cs23b2009@iiitdm.ac.in
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('templates/footer-1.ejs') -%>
</body>

</html>