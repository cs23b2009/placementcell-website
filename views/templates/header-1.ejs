<div class="in-spacing" id="in-spacing"></div>

<script>
    function updateHeaderSpacing() {
        var nav = document.querySelector(".top-navbar");
        var spacer = document.getElementById("in-spacing");
        if (nav && spacer) {
            spacer.style.marginTop = nav.clientHeight + "px";
        }
    }

    // Run layout adjustments
    window.addEventListener("load", updateHeaderSpacing);
    window.addEventListener("resize", updateHeaderSpacing);
    document.addEventListener("DOMContentLoaded", updateHeaderSpacing);
    setTimeout(updateHeaderSpacing, 200); // Back-up execution

    function toggleMobileMenu() {
        var drawer = document.getElementById("mobile-drawer");
        var overlay = document.getElementById("mobile-drawer-overlay");
        if (drawer && overlay) {
            drawer.classList.toggle("active");
            overlay.classList.toggle("active");
        }
    }

    function toggleDrawerDropdown(id) {
        var dropdown = document.getElementById(id);
        if (dropdown) {
            var btn = dropdown.previousElementSibling;
            var currentMode = window.getComputedStyle(dropdown).display;
            
            if (currentMode === "none") {
                dropdown.style.display = "flex";
                if (btn) btn.classList.add("active");
            } else {
                dropdown.style.display = "none";
                if (btn) btn.classList.remove("active");
            }
        }
    }
</script>